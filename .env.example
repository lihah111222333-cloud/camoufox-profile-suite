# Profile Service ('gpm', 'dolphin', or 'camoufox')
PROFILE_SERVICE=camoufox

# Camoufox Anti-Detect Engine Settings
CAMOUFOX_OS=windows
CAMOUFOX_HEADLESS=false
CAMOUFOX_HUMANIZE=true
CAMOUFOX_GEOIP=true
CAMOUFOX_CANVAS_NOISE=true
# The default profiles directory is under the app state directory.
# CAMOUFOX_STORAGE_DIR=/path/to/existing/profiles

# URL filtering. For a forced, operator-managed egress proxy see ENV_VARIABLES.md.
CAMOUFOX_PORT_SCAN_MODE=url-only

# Camoufox traffic recording. Native key logs require a dedicated browser.
CAMOUFOX_RECORD_TRAFFIC=true
# Opt in only when private raw body attachments are needed.
CAMOUFOX_RECORD_BODIES=false
CAMOUFOX_RECORD_WIRE_LOG=true
CAMOUFOX_SSLKEYLOG=false
CAMOUFOX_NECKO_MOZ_LOG=false
CAMOUFOX_NECKO_MOZ_LOG_MODULES=timestamp,nsHttp:5,nsSocketTransport:5,nsHostResolver:4
CAMOUFOX_RECORD_HAR=false
CAMOUFOX_TRAFFIC_MAX_BODY_BYTES=5242880

# GPM Login API URL
GPM_API_URL=http://127.0.0.1:14517
# Enable only for your trusted numeric loopback controller. See ENV_VARIABLES.md.
# GPM_TRUSTED_HTTP_API_URL=http://127.0.0.1:14517

# Optional key for separate SMS Verification library use
# SMS_VERIFY_API_KEY=your_sms_verify_api_key_here

# Application Settings
ACCOUNTS_COUNT=1
THREADS_COUNT=1
LOG_LEVEL=info
TEST_PROXY=true
