# Profile Service ('gpm', 'dolphin', or 'camoufox')
PROFILE_SERVICE=camoufox

# Camoufox Anti-Detect Engine Settings
CAMOUFOX_OS=windows
CAMOUFOX_HEADLESS=false
CAMOUFOX_HUMANIZE=true
CAMOUFOX_GEOIP=true
CAMOUFOX_CANVAS_NOISE=true
CAMOUFOX_STORAGE_DIR=./profiles

# Camoufox Pre-TLS Traffic Recording & NSS SSLKEYLOGFILE Attribution
CAMOUFOX_RECORD_TRAFFIC=true
CAMOUFOX_RECORD_BODIES=true
CAMOUFOX_SSLKEYLOG=true
CAMOUFOX_RECORD_HAR=false
CAMOUFOX_TRAFFIC_MAX_BODY_BYTES=5242880

# GPM Login API URL
GPM_API_URL=http://127.0.0.1:14517

# OMO Captcha API Key
OMOCAPTCHA_KEY=your_omocaptcha_key_here

# SMS Verification API Key
SMS_VERIFY_API_KEY=your_sms_verify_api_key_here

# Application Settings
ACCOUNTS_COUNT=1
THREADS_COUNT=1
LOG_LEVEL=info
TEST_PROXY=true
