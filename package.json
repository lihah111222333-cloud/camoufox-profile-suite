  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "list-folders": "node scripts/list-dolphin-folders.js",
    "verify-camoufox": "node scripts/verify-camoufox-coherence.js",
    "audit-traffic": "node scripts/query-traffic-attribution.js",
    "test:isolation": "node scripts/test-camoufox-isolation.js",
    "test:coherence": "node scripts/test-coherence-auditor.js",
    "test:compat": "node scripts/test-page-compat.js",
    "test:traffic": "node scripts/test-traffic-attribution.js",
    "test:security": "cd tests/security && node --test",
    "test": "node scripts/test-camoufox-isolation.js && node scripts/test-coherence-auditor.js && node scripts/test-page-compat.js && node scripts/test-traffic-attribution.js && node scripts/verify-camoufox-coherence.js --dry-run && npm run test:security",
    "prepack": "node scripts/check-distribution.mjs pack && node --check src/index.js && node --check bin/gmail-account-creator.js"
  },
  "keywords": [
    "gmail",
    "automation",
